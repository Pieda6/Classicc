# ---- Database (PostgreSQL) ----
# On Vercel, adding the Neon integration sets both of these automatically.
# Locally, point both at any Postgres database (e.g. a free Neon branch or Docker).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classicc"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/classicc"

# ---- Site ----
# Your public URL (on Vercel it falls back to the project's production domain if empty)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Long random string used to sign login sessions: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Paystack ----
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Set your webhook URL in Paystack to: https://YOUR-DOMAIN/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Store currency supported by your Paystack account (NGN, GHS, ZAR, KES, USD)
NEXT_PUBLIC_CURRENCY="NGN"

# ---- Email (SMTP) ----
# When SMTP_HOST is empty, emails are printed to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CLASSICCC <hello@classicc.com>"
# Where contact-form messages and new-order alerts are sent
STORE_NOTIFY_EMAIL="hello@classicc.com"

# ---- Image uploads ----
# On Vercel: create a Blob store (Storage tab) and BLOB_READ_WRITE_TOKEN is set for you.
# Without it, uploads are saved to UPLOAD_DIR on local disk (fine for local dev only).
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./uploads"

# ---- Business details (shown on Contact page, footer, emails) ----
NEXT_PUBLIC_STORE_EMAIL="hello@classicc.com"
NEXT_PUBLIC_STORE_PHONE="+234 800 000 0000"
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"
NEXT_PUBLIC_STORE_ADDRESS="12 Admiralty Way, Lekki Phase 1, Lagos, Nigeria"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/classicc"
NEXT_PUBLIC_TIKTOK="https://tiktok.com/@classicc"
NEXT_PUBLIC_X="https://x.com/classicc"

# ---- Seed admin account (used by `npm run db:seed`) ----
ADMIN_EMAIL="admin@classicc.com"
ADMIN_PASSWORD="ChangeMe123!"
